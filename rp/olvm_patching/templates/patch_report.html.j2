<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Patching {{ patch_report.ticket }} — {{ patch_report.overall }}</title>
<style>
  body { font: 14px/1.45 -apple-system, "Segoe UI", Roboto, sans-serif; margin: 24px; color: #1d1d1f; background: #fff; }
  h1 { font-size: 20px; margin: 0 0 4px; }
  .muted { color: #6e6e73; }
  .badge { display: inline-block; padding: 2px 10px; border-radius: 10px; font-weight: 600; color: #fff; }
  .SUCCESS { background: #1a7f37; } .PARTIAL { background: #bf8700; } .FAILED, .HALTED { background: #cf222e; }
  table { border-collapse: collapse; width: 100%; margin: 16px 0; }
  th, td { text-align: left; padding: 6px 10px; border-bottom: 1px solid #e5e5ea; vertical-align: top; }
  th { background: #f5f5f7; font-weight: 600; }
  .o-patched, .o-no_updates { color: #1a7f37; } .o-excluded { color: #6e6e73; }
  .o-precheck_failed, .o-snapshot_failed, .o-patch_failed, .o-not_attempted { color: #cf222e; font-weight: 600; }
  details summary { cursor: pointer; }
  code { font-size: 12px; }
</style>
</head>
<body>
<h1>OS patching — {{ patch_report.ticket }} <span class="badge {{ patch_report.overall }}">{{ patch_report.overall }}</span></h1>
<p class="muted">
  Patch group <b>{{ patch_change.patch_group | default('n/a') }}</b> ·
  mode <b>{{ patch_mode }}</b> ·
  generated {{ patch_report.generated }} ·
  AAP job {{ tower_job_id | default(awx_job_id | default('n/a')) }}
</p>

{% if patch_report.hosts | selectattr('test_mode') | list | length > 0 %}
<p style="background:#cf222e;color:#fff;padding:8px 12px;border-radius:6px;font-weight:600">
  TEST MODE — {{ patch_report.hosts | selectattr('test_mode') | list | length }} host(s) patched WITHOUT a pre-patch snapshot. Development run only.
</p>
{% endif %}

<table>
  <tr>{% for k, v in patch_report.counts | dictsort %}<th>{{ k }}</th>{% endfor %}</tr>
  <tr>{% for k, v in patch_report.counts | dictsort %}<td>{{ v }}</td>{% endfor %}</tr>
</table>

<table>
  <tr>
    <th>Host</th><th>Outcome</th><th>Updates</th><th>Kernel</th><th>Rebooted</th>
    <th>Snapshot</th><th>Detail</th>
  </tr>
{% for r in patch_report.hosts %}
  <tr>
    <td>{{ r.host }}</td>
    <td class="o-{{ r.outcome }}">{{ r.outcome }}</td>
    <td>
      {% if r.packages %}
      <details><summary>{{ r.installed }} installed</summary>
        <code>{{ r.packages | join('<br>') }}</code>
      </details>
      {% else %}{{ r.updates }} available{% endif %}
    </td>
    <td>{{ r.kernel_before }}{% if r.kernel_after and r.kernel_after != r.kernel_before %} → <b>{{ r.kernel_after }}</b>{% endif %}</td>
    <td>{{ 'yes' if r.rebooted | bool else '' }}</td>
    <td>{% if r.snapshot_id %}{{ r.vm }}<br><code>{{ r.snapshot_id }}</code>{% endif %}</td>
    <td>{{ r.detail | e }}</td>
  </tr>
{% endfor %}
</table>

{% if patch_report.hosts | selectattr('snapshot_id') | list | length > 0 %}
<p>Pre-patch OLVM snapshots are retained until <b>{{ patch_report.retain_until }}</b>
({{ snapshot_retention_days }} days). Deletion requires approval in the cleanup workflow.</p>
{% endif %}
</body>
</html>
