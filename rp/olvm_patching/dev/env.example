# ------------------------------------------------------------------------------
# dev/env.example — copy to dev/env (git-ignored), fill in, then:
#   source dev/env
#
# Stands in for the AAP credentials / Azure Key Vault. In AAP these variables
# are injected by the Jira, Device42 and OLVM credential types.
# ------------------------------------------------------------------------------

# Jira — a free Jira Cloud site, or the local mock:
#   python3 dev/mock_jira.py 8765 &      →  JIRA_URL=http://127.0.0.1:8765
export JIRA_URL="https://<your-site>.atlassian.net"
export JIRA_USER="<email>"
export JIRA_TOKEN="<api token>"

# Device42 — only for testing inventory/device42.d42.yml against a real or
# trial Device42; the dev static inventory does not need it
# export D42_URL="https://<device42>"
# export D42_USER="<user>"
# export D42_PWD="<password>"

# OLVM — not used in snapshot test mode
# export OVIRT_URL="https://<engine>/ovirt-engine/api"
# export OVIRT_USERNAME="<user>@internal"
# export OVIRT_PASSWORD="<password>"
# export OVIRT_CA_FILE="/path/to/engine-ca.pem"
